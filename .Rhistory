install.packages(c("backports", "BH", "broom", "callr", "cli", "colorspace", "cpp11", "crosstalk", "data.table", "dbplyr", "digest", "DT", "e1071", "gdtools", "generics", "ggplot2", "hexbin", "htmltools", "htmlwidgets", "isoband", "jqr", "jsonlite", "labeling", "leaflet", "lubridate", "magrittr", "pillar", "pkgbuild", "plotly", "processx", "ps", "R6", "raster", "rgdal", "rlang", "rmarkdown", "rprojroot", "rstudioapi", "sf", "sp", "stringi", "testthat", "tibble", "tinytex", "V8", "vctrs", "xfun"))
