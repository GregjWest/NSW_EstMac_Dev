if(!require(shiny)) install.packages("shiny", repos = "http://cran.us.r-project.org")
# Function to extract unique catchments from the geojson data
get_unique_catchments <- function(geojson_data) {
catchments <- str_extract_all(geojson_data, "(?<=catchment)([[:alnum:]]+)") %>%
unlist %>%
unique
return(catchments)
}
# Function to subset the geojson data for a selected catchment
subset_geojson_data <- function(geojson_data, catchment) {
selected_geojson_data <- str_detect(geojson_data, paste0("catchment", catchment)) %>%
which %>%
head(1)
end_index <- which(str_detect(geojson_data[selected_geojson_data:length(geojson_data)], "}"))[1] + selected_geojson_data - 1
return(paste(geojson_data[selected_geojson_data:end_index], collapse = "\n"))
}
